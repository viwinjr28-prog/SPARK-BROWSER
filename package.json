{
  "name": "spark-browser",
  "version": "2.0.0",
  "description": "Spark Browser — Liquid Glass edition",
  "main": "main.js",
  "scripts": { "start": "electron .", "pack": "electron-builder --dir", "dist": "electron-builder" },
  "devDependencies": { "electron": "^35.0.0", "electron-builder": "^26.0.0" },
  "build": {
    "appId": "com.sparkos.browser",
    "productName": "Spark Browser",
    "mac": { "category": "public.app-category.productivity" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
}